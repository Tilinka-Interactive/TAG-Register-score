rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Reglas para partidas_registradas
    match /partidas_registradas/{partidaId} {
      // Permitir lectura y escritura si el documento existe pero está vacío
      // o si el usuario está autenticado
      allow read: if true;
      allow write: if request.resource.data.keys().hasAll(['id', 'avatarCode', 'score', 'horaIni', 'horaFin', 'nombre', 'email']);
    }
    
    // Reglas para scores
    match /scores/{scoreId} {
      allow read: if true;
      allow write: if true; // Ajustar según necesidades de seguridad
    }
    
    // Reglas para users
    match /users/{userId} {
      allow read: if true;
      // Permitir escritura si:
      // 1. El usuario está autenticado Y el userId coincide con su uid (registro con Google)
      // 2. O si se está creando/actualizando un documento con email y nombre válidos (registro manual)
      allow write: if (request.auth != null && request.auth.uid == userId) ||
                   (request.resource.data.keys().hasAll(['email', 'nombre']) && 
                    request.resource.data.email is string &&
                    request.resource.data.nombre is string &&
                    request.resource.data.email.size() > 0 &&
                    request.resource.data.nombre.size() > 0);
    }
  }
}

